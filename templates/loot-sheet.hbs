<form class="{{cssClass}} candlelight-sheet loot-sheet"><header class="cl-header"><img class="profile-img" src="{{actor.img}}"/><div class="cl-title"><h2>{{actor.name}}</h2><p>Dropped on the ground</p></div></header><section><ol class="items-list">{{#each cl.items as |item|}}<li><img src="{{item.img}}"/><span><strong>{{item.name}}</strong><small>{{item.type}}</small></span><button type="button" data-action="pickup" data-item-id="{{item.id}}"><i class="fa-solid fa-hand"></i> Pick Up</button></li>{{else}}<li class="hint">Empty.</li>{{/each}}</ol>{{#if cl.items.length}}<button type="button" data-action="pickup-all">Pick Up All</button>{{/if}}</section></form>